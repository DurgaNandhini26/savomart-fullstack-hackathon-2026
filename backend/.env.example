# Copy to backend/.env and adjust. Never commit backend/.env.

# Savomart stores API token (shared in the hackathon brief). Without it the committed
# snapshot in data/seed/stores.json is used.
STORES_API_TOKEN=

# LLM provider: none | anthropic | openai   (openai = any OpenAI-compatible endpoint)
#   anthropic : LLM_API_KEY=sk-ant-...           LLM_MODEL=claude-haiku-4-5-20251001
#   openai    : LLM_API_KEY=sk-...               LLM_MODEL=gpt-4o-mini
#   groq      : LLM_PROVIDER=openai LLM_BASE_URL=https://api.groq.com/openai/v1 LLM_MODEL=llama-3.3-70b-versatile
#   ollama    : LLM_PROVIDER=openai LLM_BASE_URL=http://localhost:11434/v1 LLM_MODEL=llama3.1
# With "none" the app writes deterministic, template-based narratives (fully functional).
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

SECRET_KEY=change-me
ENABLE_REVERSE_GEOCODE=true
